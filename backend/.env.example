# ═══════════════════════════════════════════════
# Fin.D Backend Environment Configuration
# Copy this file as .env and fill in your keys
# ═══════════════════════════════════════════════

# ── Primary LLM: Groq LPU (~250ms latency) ──
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_PROVIDER=groq

# ── Secondary LLM: OpenRouter (fallback) ──
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o

# ── Market Data: Alpha Vantage ──
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# ── Vector Database: ChromaDB Cloud ──
CHROMA_HOST=api.trychroma.com
CHROMA_API_KEY=your_chroma_api_key_here
CHROMA_TENANT=your_chroma_tenant_here
CHROMA_DATABASE=find
